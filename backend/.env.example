# ---------------------------------------------------------------------------
# ParcelPilot backend configuration.
# Copy to `.env` and fill in secrets.  `.env` is gitignored.
# The app runs with ZERO changes here (offline mock LLM) — the key only
# upgrades chat quality.
# ---------------------------------------------------------------------------

# --- Application ---------------------------------------------------------
APP_ENV=development                 # development | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
API_HOST=0.0.0.0
API_PORT=8000

# CORS — the Next.js dev origin
CORS_ORIGINS=http://localhost:3000

# --- Database ------------------------------------------------------------
# Local-first default (no Docker needed). Swap for a Postgres+pgvector URL
# in production, e.g. postgresql+psycopg://user:pass@host:5432/parcelpilot
DATABASE_URL=sqlite:///./data/parcelpilot.db

# --- LLM (OpenRouter, OpenAI-compatible) ---------------------------------
# Leave LLM_API_KEY blank to run fully offline with the deterministic mock.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini        # any model id available on your OpenRouter account
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_SECONDS=60

# Optional headers OpenRouter uses for attribution (safe to leave as-is)
OPENROUTER_REFERER=http://localhost:3000
OPENROUTER_TITLE=ParcelPilot Support Intelligence

# --- Embeddings ----------------------------------------------------------
# OpenRouter has no embeddings endpoint. Point these at any OpenAI-compatible
# embeddings server (OpenAI, Ollama, etc.) to upgrade retrieval quality.
# Leave EMBEDDINGS_API_KEY blank to use the deterministic local embedder.
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDING_DIM=256                   # local fallback dimension; ignored for remote models

# --- Security ------------------------------------------------------------
# Mock-auth signing secret. Real RBAC is enforced server-side regardless.
AUTH_SECRET=dev-secret-change-me
RATE_LIMIT_PER_MINUTE=60

# --- Domain time ---------------------------------------------------------
# Reference "now" for all time-based logic (dataset snapshot from the workbook
# README). Keep this for the assessment data.
REFERENCE_TIME=2026-08-16 11:00

# --- Retrieval tuning ----------------------------------------------------
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATE_K=24
HYBRID_ALPHA=0.55                   # weight of vector vs keyword (0=keyword only, 1=vector only)
MMR_LAMBDA=0.7                      # diversity vs relevance in re-ranking
